# ==========================================
# DOCKER ENVIRONMENT CONFIGURATION
# ==========================================
# This file is used for Docker container configuration
# Copy this file and update with your actual values
# DO NOT commit sensitive credentials to version control

# ==========================================
# DATABASE CONFIGURATION (External MySQL)
# ==========================================
USE_MYSQL=True
DB_NAME=cpq_kitup
DB_USER=your_db_user
DB_PASSWORD=your_db_password
# Use host.docker.internal to connect to MySQL on host machine
# Or use external MySQL server IP/hostname
DB_HOST=host.docker.internal
DB_PORT=3306

# ==========================================
# DJANGO SECURITY
# ==========================================
# IMPORTANT: Generate a new secret key for production
# You can generate one using: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=django-insecure-change-this-in-production-abc123xyz789
DEBUG=False

# Allowed hosts (comma-separated, no spaces)
# Add your production domain here
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com,dev-saskitup.it.sas.co.nz

# CSRF Trusted Origins (comma-separated, include http:// or https://)
# IMPORTANT: Add your production domain with https://
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://dev-saskitup.it.sas.co.nz,http://localhost:8000

# ==========================================
# EMAIL CONFIGURATION
# ==========================================
# Backend options: 'console' (development) or 'smtp' (production)
EMAIL_BACKEND=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@domain.com
# For Gmail: Generate App Password at https://myaccount.google.com/apppasswords
EMAIL_HOST_PASSWORD=your_app_password_here

# ==========================================
# CIN7 API CONFIGURATION
# ==========================================
CIN7_API_USERNAME=your_cin7_username
CIN7_API_KEY=your_cin7_api_key
CIN7_API_URL=https://api.cin7.com/api/v1
CIN7_WHOLE_SALE_ID=190

# ==========================================
# LOTTO SPORTS SITE CONFIGURATION
# ==========================================
LOTTO_SITE_URL=https://dev-lottosports.it.sas.co.nz

# WooCommerce API Configuration - LOTTO
LOTTO_WOOCOMMERCE_API_URL=https://dev-lottosports.it.sas.co.nz/wp-json/wc/v3/
LOTTO_WOOCOMMERCE_API_CONSUMER_KEY=your_lotto_consumer_key
LOTTO_WOOCOMMERCE_API_SECRET=your_lotto_consumer_secret

# ==========================================
# SAS WOOCOMMERCE API CONFIGURATION
# ==========================================
SAS_WOOCOMMERCE_API_URL=https://dev-sas-test.it.sas.co.nz/wp-json/wc/v3/
SAS_WOOCOMMERCE_API_CONSUMER_KEY=your_sas_consumer_key
SAS_WOOCOMMERCE_API_SECRET=your_sas_consumer_secret

# ==========================================
# TUS WOOCOMMERCE API CONFIGURATION
# ==========================================
TUS_WOOCOMMERCE_API_URL=https://theuniformshoppe.co.nz/wp-json/wc/v3/
TUS_WOOCOMMERCE_API_CONSUMER_KEY=your_tus_consumer_key
TUS_WOOCOMMERCE_API_SECRET=your_tus_consumer_secret

# ==========================================
# SYNC CONFIGURATION
# ==========================================
USE_TWO_PHASE_SYNC=False

# Database Configuration
USE_MYSQL=True
DB_NAME=your_database_name
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=3306

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
DEBUG=True

# Allowed Hosts (comma-separated, no spaces)
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# CSRF Trusted Origins (comma-separated, include http:// or https://)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,http://localhost:8000

# ==========================================
# EMAIL CONFIGURATION
# ==========================================
# Backend: 'console' for development/testing, 'smtp' for production
EMAIL_BACKEND=console

# SMTP Settings (only needed when EMAIL_BACKEND=smtp)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com

# For Gmail: Generate App Password at https://myaccount.google.com/apppasswords
# Regular password won't work - Gmail requires App Password for security
# Steps:
# 1. Enable 2-Factor Authentication: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Copy the 16-character password (remove spaces)
EMAIL_HOST_PASSWORD=your-gmail-app-password

# Optional: Custom sender display name
DEFAULT_FROM_EMAIL=Your Company <your-email@gmail.com>

# Cin7 API Configuration
CIN7_API_USERNAME=your_cin7_username
CIN7_API_KEY=your_cin7_api_key
CIN7_API_URL=https://api.cin7.com/api/v1
CIN7_WHOLE_SALE_ID=your_wholesale_id

# LOTTO Sports Site Configuration
LOTTO_SITE_URL=https://your-lotto-site.com

# WooCommerce API Configuration - LOTTO
LOTTO_WOOCOMMERCE_API_URL=https://your-lotto-site.com/wp-json/wc/v3/
LOTTO_WOOCOMMERCE_API_CONSUMER_KEY=your_consumer_key
LOTTO_WOOCOMMERCE_API_SECRET=your_consumer_secret

# WooCommerce API Configuration - SAS
SAS_WOOCOMMERCE_API_URL=https://your-sas-site.com/wp-json/wc/v3/
SAS_WOOCOMMERCE_API_CONSUMER_KEY=your_consumer_key
SAS_WOOCOMMERCE_API_SECRET=your_consumer_secret

# WooCommerce API Configuration - TUS
TUS_WOOCOMMERCE_API_URL=https://your-tus-site.com/wp-json/wc/v3/
TUS_WOOCOMMERCE_API_CONSUMER_KEY=your_consumer_key
TUS_WOOCOMMERCE_API_SECRET=your_consumer_secret

# Sync Configuration
USE_TWO_PHASE_SYNC=False

# Test User Credentials (Development only)
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=change-this-password

SALES_REP_USERNAME=sales@example.com
SALES_REP_PASSWORD=change-this-password

ACCOUNT_MANAGER_USERNAME=manager@example.com
ACCOUNT_MANAGER_PASSWORD=change-this-password

CUSTOMER_USERNAME=customer@example.com
CUSTOMER_PASSWORD=change-this-password
